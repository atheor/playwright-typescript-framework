{
  "name": "@atheor/playwright-framework",
  "version": "1.0.0",
  "description": "Production-ready test automation framework using Playwright with TypeScript supporting UI, API, and FTP testing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "ui-testing",
    "api-testing",
    "ftp-testing",
    "e2e",
    "testing-framework"
  ],
  "author": "Atheor",
  "license": "MIT",
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "basic-ftp": "^5.0.4",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "@faker-js/faker": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atheor/playwright-typescript-framework.git"
  }
}
